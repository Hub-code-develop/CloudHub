<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource ThemeBackgroundBrush}">
      <StackPanel Spacing="10">
        <Border Classes="Card">
          <StackPanel>
            <TextBlock Classes="SectionTitle" Text="示例卡片标题" />
            <TextBlock Classes="Muted" Text="这是一段说明文字。" />
          </StackPanel>
        </Border>
        <Button Classes="accent" Content="主要按钮" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- 品牌色：Azure 蓝 -->
  <Style Selector="SolidColorBrush.cloudAccent" />

  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource Ch.CardBg}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ch.CardBorder}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #20000000" />
  </Style>

  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ch.TextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <!-- 说明文字：直接用自适应的 Muted 色，不用 Opacity（深色下 Opacity hack 会隐形） -->
  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource Ch.TextMuted}" />
  </Style>

  <Style Selector="TextBlock.Hero">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Ch.TextPrimary}" />
  </Style>

  <!-- 危险操作文字（替代硬编码 #C42B1C，深色下自动换亮红） -->
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource Ch.Danger}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Foreground" Value="{DynamicResource Ch.OnAccent}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- FA 模板在深色变体下会用主题前景色盖掉 Button.Foreground，钉死到模板层 -->
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Ch.OnAccent}" />
  </Style>

  <Style Selector="Button.accent:pointerover">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
  </Style>

  <Style Selector="Button.accent:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
  </Style>

  <!-- 空状态占位 -->
  <Style Selector="Border.EmptyState">
    <Setter Property="Background" Value="{DynamicResource Ch.CardBg}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="28" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ch.CardBorder}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="Watermark" Value="搜索资源、资源组、类型…" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>

  <Style Selector="Border.StatusBadge">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,1" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2}" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
  </Style>

</Styles>
