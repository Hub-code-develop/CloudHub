<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:CloudHub.Desktop.Converters"
             x:Class="CloudHub.Desktop.Views.ResourceGraphView">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="Hero" Text="资源图谱 (KQL)" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="accent" Content="运行查询" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}" />
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="*,*" Margin="0,10,0,0">
      <Border Classes="Card" Margin="0,0,0,8">
        <TextBox AcceptsReturn="True" FontFamily="Cascadia Code, monospace" Text="{Binding Query}"
                 Watermark="输入 KQL，例如：resources | limit 100" />
      </Border>

      <Border Grid.Row="1" Classes="Card">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="SectionTitle" Text="{Binding ResultCount, StringFormat='结果 ({0})'}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="Muted" FontSize="12" Text="{Binding Elapsed, StringFormat='耗时 {0}'}" />
              <TextBlock Classes="Muted" FontSize="12" Text="{Binding TotalRecords, StringFormat='总计 {0}'}" />
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="1">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="180" Padding="6" Background="{DynamicResource ThemeControlMidBrush}"
                            BorderBrush="{DynamicResource ThemeControlBorderBrush}" BorderThickness="0,0,1,1">
                      <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource ThemeControlBorderBrush}" BorderThickness="0,0,0,1">
                      <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Width="180" Padding="6" BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                    BorderThickness="0,0,1,0">
                              <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <TextBlock Grid.Row="2" Classes="Muted" FontSize="11" Margin="0,6,0,0"
                     Text="{Binding EmptyHint}"
                     IsVisible="{Binding EmptyHint, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{DynamicResource Ch.Danger}" TextWrapping="Wrap" Margin="0,8,0,0"
               IsVisible="{Binding Error, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
  </Grid>
</UserControl>
