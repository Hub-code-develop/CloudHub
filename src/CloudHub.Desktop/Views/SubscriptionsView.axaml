<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:CloudHub.Desktop.Converters"
             x:Class="CloudHub.Desktop.Views.SubscriptionsView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="Hero" Text="订阅" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshCommand}" Content="刷新" />
    </Grid>

    <TextBlock Grid.Row="1" Classes="Muted" Text="{Binding Error}" Foreground="{DynamicResource Ch.Danger}" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" Margin="0,4,0,8" />

    <Border Grid.Row="2" Classes="Card">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="SectionTitle" Text="{Binding Items.Count, StringFormat='订阅列表 ({0})'}" />
        <TextBlock Grid.Row="1" Classes="Muted" Text="{Binding EmptyHint}" TextWrapping="Wrap"
                   IsVisible="{Binding EmptyHint, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
        <ScrollViewer Grid.Row="1">
          <ItemsControl x:Name="SubList" ItemsSource="{Binding Items}" Tag="{Binding}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Classes="Muted" FontSize="11" Text="{Binding Id}" />
                    <TextBlock Classes="Muted" FontSize="11"
                               Text="{Binding State, StringFormat='状态：{0}'}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0"
                          Content="设为当前"
                          Command="{Binding #SubList.Tag.UseThisCommand}"
                          CommandParameter="{Binding}"
                          IsVisible="{Binding Id, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
