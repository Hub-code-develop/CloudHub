<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="CloudHub.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CloudHub/Resources/CloudHubPalette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- FluentAvaloniaTheme 自带完整 Fluent 样式，不要再引 Avalonia.Themes.Fluent -->
    <sty:FluentAvaloniaTheme />
    <StyleInclude Source="avares://CloudHub/Styles/CloudHubTheme.axaml" />
  </Application.Styles>

</Application>
